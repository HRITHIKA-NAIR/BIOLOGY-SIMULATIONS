{
  "name": "science-practicals",
  "version": "1.0.0",
  "description": "Original interactive school science practical previews with device saving and offline access",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/unit.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run test:e2e",
    "format": "prettier --write apps content scripts tests playwright.config.js",
    "format:check": "prettier --check apps content scripts tests playwright.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HRITHIKA-NAIR/BIOLOGY-SIMULATIONS.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/HRITHIKA-NAIR/BIOLOGY-SIMULATIONS/issues"
  },
  "homepage": "https://github.com/HRITHIKA-NAIR/BIOLOGY-SIMULATIONS#readme",
  "dependencies": {
    "animejs": "^4.5.0",
    "iconoir": "^7.12.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.63.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
